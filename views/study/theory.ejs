<h2 id="express">5. Express.js — Полное руководство</h2>

<h3>5.1 Архитектура Express</h3>

<p>Express — это <strong>цепочка middleware</strong>. Каждый запрос проходит через middleware-функции до到达 обработчика маршрута.</p>

<div class="diagram">
Запрос → [json()] → [session()] → [auth] → [RBAC] → [Router] → [Handler] → Ответ
         middleware middleware middleware middleware    controller
</div>

<h3>5.2 Middleware — Полная модель</h3>

<h4>Типы middleware</h4>

<table style="width:100%;border-collapse:collapse;margin:12px 0;">
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;color:#2dff7a;width:25%;"><strong>Тип</strong></td><td style="padding:6px;color:#2dff7a;width:40%;"><strong>Описание</strong></td><td style="padding:6px;color:#2dff7a;width:35%;"><strong>Пример</strong></td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Application-level</td><td style="padding:6px;">app.use() — для всех запросов</td><td style="padding:6px;">app.use(express.json())</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Router-level</td><td style="padding:6px;">router.use() — для конкретного роутера</td><td style="padding:6px;">router.use(isAuth)</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Error-handling</td><td style="padding:6px;">4 аргумента (err, req, res, next)</td><td style="padding:6px;">app.use((err, req, res, next) => {...})</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Built-in</td><td style="padding:6px;">Встроенные в Express</td><td style="padding:6px;">express.json(), express.static()</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Third-party</td><td style="padding:6px;">npm пакеты</td><td style="padding:6px;">cors, helmet, morgan</td></tr>
</table>

<h4>next() — три варианта</h4>

<div class="code-block">
// 1. next() — передать следующей middleware
app.use((req, res, next) => {
    req.customData = 'hello';
    next();  // ← Передаём дальше
});

// 2. next('route') — пропустить остальные middleware для этого маршрута
router.get('/admin', checkRole, (req, res) => {
    if (req.user.role === 'admin') {
        next('route');  // ← Перейти к следующему маршруту
    }
});

// 3. next(err) — передать ошибку в error-handling middleware
app.use((req, res, next) => {
    try {
        doSomething();
        next();
    } catch (err) {
        next(err);  // ← Передать ошибку
    }
});
</div>

<h4>Error-handling middleware</h4>

<div class="code-block">
// 4 аргумента — Express определяет как error-handling
app.use((err, req, res, next) => {
    console.error(err.stack);
    res.status(err.status || 500).json({
        success: false,
        message: err.message || 'Internal Server Error'
    });
});
</div>

<h3>5.3 Router</h3>

<div class="code-block">
import { Router } from 'express';

const router = Router({ mergeParams: true }); // Доступ к params родителя

// Параметры маршрутов
router.get('/:id', (req, res) => {
    console.log(req.params.id);  // '123' для /products/123
});

// Необязательные параметры (?)
router.get('/:id?', (req, res) => {
    if (!req.params.id) { /* список */ }
    else { /* конкретный */ }
});

// Цепочка для одного пути
router.route('/:id')
    .get(controller.show)
    .put(controller.update)
    .delete(controller.delete);
</div>

<h3>5.4 Request Object (req)</h3>

<div class="code-block">
req.body          // Тело запроса (POST/PUT) — через express.json()
req.params        // Параметры маршрута (:id, :username)
req.query         // Строка запроса (?page=1&limit=10)
req.headers       // HTTP-заголовки
req.cookies       // Cookies (через cookie-parser)
req.session       // Сессия (через express-session)
req.method        // 'GET', 'POST', 'PUT', 'DELETE'
req.url           // Полный URL
req.path          // Путь без query string
req.hostname      // Имя хоста
req.ip            // IP-адрес клиента
req.accepts('html') // Content Negotiation
req.is('application/json') // Проверка Content-Type
</div>

<h3>5.5 Response Object (res)</h3>

<div class="code-block">
res.status(200)                  // Установить HTTP статус
res.json({ success: true })      // JSON ответ
res.send('Hello')                // Текст/HTML
res.render('page', { data })     // Рендер шаблона (EJS, Pug)
res.redirect('/new-url')         // Редирект 302
res.redirect(301, '/new-url')    // Постоянный редирект
res.sendFile(path.join(...))     // Отправка файла
res.setHeader('X-Custom', 'val') // Заголовок
res.cookie('token', value, { httpOnly: true }) // Установить cookie
res.clearCookie('token')         // Удалить cookie
</div>

<h3>5.6 Express 5 — Обработка ошибок</h3>

<div class="code-block">
// Express 5 автоматически ловит ошибки в async-обработчиках
router.get('/:id', async (req, res) => {
    const user = await UserService.getById(req.params.id); // Ошибка = автоматический catch
    return res.json({ success: true, data: user });
});

// Express 4 — требовал обёртку:
router.get('/:id', asyncHandler(async (req, res) => {
    const user = await UserService.getById(req.params.id);
}));
</div>

<h3>5.7 Шаблонизаторы</h3>

<div class="code-block">
// EJS — Embedded JavaScript
&lt;%= user.username %&gt;      // Экранированный вывод
&lt;%- user.username %&gt;      // Без экранирования (ОПАСНО!)
&lt;% if (user) { %&gt;          // Логика
&lt;% } %&gt;

// Pug — indentation-based
h1= user.username
if user
    p= user.email

// Handlebars — Mustache-like
&lt;h1&gt;{{user.username}}&lt;/h1&gt;
{{#if user}}&lt;p&gt;Logged in&lt;/p&gt;{{/if}}
</div>

