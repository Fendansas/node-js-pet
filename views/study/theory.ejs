<h3>7.2 CRUD операции</h3>

<div class="code-block">
// CREATE
await User.create({ username: 'stalker', email: 's@z.a', money: 100 });
await User.insertMany([{ username: 'a' }, { username: 'b' }]);

// READ
await User.find({ status: 'active' });           // Все документы
await User.findOne({ username: 'admin' });        // Один документ
await User.findById('64a1b2c3');                  // По ID

// UPDATE
await User.updateOne({ _id: id }, { $set: { money: 200 } });
await User.findByIdAndUpdate(id, { money: 200 }, { new: true });
// $inc — инкремент
await User.updateOne({ _id: id }, { $inc: { money: 50 } });
// $push — добавить в массив
await User.updateOne({ _id: id }, { $push: { inventory: { product: 'p1', count: 1 } } });
// $pull — удалить из массива
await User.updateOne({ _id: id }, { $pull: { inventory: { product: 'p1' } } });
// $addToSet — добавить если ещё нет
await User.updateOne({ _id: id }, { $addToSet: { tags: 'vip' } });

// DELETE
await User.deleteOne({ _id: id });
await User.deleteMany({ status: 'banned' });
</div>

<h3>7.3 Индексы</h3>

<div class="code-block">
// Уникальный индекс
username: { type: String, unique: true }

// Составной индекс
userSchema.index({ username: 1, email: 1 });

// Текстовый индекс (поиск по тексту)
postSchema.index({ title: 'text', content: 'text' });

// Создание программно
await User.createIndex({ email: 1 }, { unique: true });

// Анализ запроса
await User.find({ email: 'test' }).explain('executionStats');
// "IXSCAN" — использование индекса (ХОРОШО)
// "COLLSCAN" — сканирование всей коллекции (ПЛОХО)
</div>

<h3>7.4 Aggregation Pipeline</h3>

<div class="code-block">
// Агрегация — цепочка этапов обработки
const results = await Order.aggregate([
    { $match: { status: 'completed' } },         // Фильтрация
    { $group: {                                   // Группировка
        _id: '$userId',
        totalSpent: { $sum: '$amount' },
        orderCount: { $sum: 1 }
    }},
    { $sort: { totalSpent: -1 } },               // Сортировка
    { $limit: 10 },                               // Лимит
    { $lookup: {                                  // JOIN с users
        from: 'users',
        localField: '_id',
        foreignField: '_id',
        as: 'user'
    }},
    { $unwind: '$user' }                          // Разворачиваем массив
]);
</div>

<h3>7.5 Репликация и шардинг</h3>

<table style="width:100%;border-collapse:collapse;margin:12px 0;">
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;color:#2dff7a;width:20%;"><strong>Концепция</strong></td><td style="padding:6px;color:#2dff7a;width:40%;"><strong>Описание</strong></td><td style="padding:6px;"><strong>Зачем</strong></td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Replica Set</td><td style="padding:6px;">Несколько копий данных (primary + secondary)</td><td style="padding:6px;">Отказоустойчивость, бэкапы</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Primary</td><td style="padding:6px;">Основной сервер, принимает записи</td><td style="padding:6px;">Единая точка записи</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Secondary</td><td style="padding:6px;">Реплики, принимают чтение</td><td style="padding:6px;">Балансировка нагрузки</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Шардинг</td><td style="padding:6px;">Разбиение данных по серверам</td><td style="padding:6px;">Масштабирование на большие объёмы</td></tr>
</table>

