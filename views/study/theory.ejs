<h3>11.1 WebSocket</h3>

<div class="code-block">
// HTTP — request/response (однонаправленный)
// WebSocket — двустороннее соединение в реальном времени

// Сервер (Socket.io)
import { Server } from 'socket.io';
const io = new Server(server);

io.on('connection', (socket) => {
    socket.emit('message', 'Добро пожаловать');     // Сервер → клиент
