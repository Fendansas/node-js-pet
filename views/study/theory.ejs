<!-- SECTION 12: DESIGN PATTERNS -->
<!-- ============================== -->

<h2 id="patterns">12. Паттерны проектирования</h2>

<p><strong>Паттерны проектирования</strong> — это проверенные решения типичных задач. Это не код, а <strong>шаблоны</strong>, которые помогают писать поддерживаемый, масштабируемый и понятный код.</p>

<h3>12.1 Singleton</h3>

<div class="q-block"><strong>Что:</strong> Гарантирует создание <strong>только одного экземпляра</strong> класса.</div>

<div class="code-block">
// Пример: сервис в проекте
class ProductService {
    constructor() {
        this.cache = new Map();
    }
    // ... методы
}

// Экспорт как Singleton — всегда один экземпляр
export default new ProductService();

// Все импорты получают один и тот же объект
import ProductService from '../services/product.service.js';
import AnotherService from '../services/another.service.js';
// ProductService === AnotherService (если оба импортируют один модуль)
</div>

<p><strong>Зачем:</strong></p>
<ul>
    <li>Экономия памяти — не создаём дубликаты</li>
    <li>Консистентность — все работают с одним состоянием</li>
    <li>Единая точка доступа — легко найти и заменить</li>
</ul>

<p><strong>Когда использовать:</strong> Сервисы, репозитории, конфигурации, логгеры, кеши.</p>
<p><strong>Когда НЕ использовать:</strong> Когда нужна изоляция (каждый запрос — свой экземпляр).</p>

<h3>12.2 Factory</h3>

<div class="q-block"><strong>Что:</strong> Функция или метод, который <strong>создаёт объекты</strong> вместо прямого вызова <span class="code-inline">new</span>.</div>

<div class="code-block">
// Factory для middleware
export const allow = (permission) => {
    return async (req, res, next) => {
        const hasAccess = await RbacService.hasPermission(req.user._id, permission);
        if (!hasAccess) return res.status(403).json({ success: false, message: 'Forbidden' });
        next();
    };
};

// Использование — фабрика создаёт middleware
router.delete('/:id', allow('product:delete'), controller.delete);
router.post('/', allow('product:create'), controller.create);
</div>

<div class="code-block">
// Factory для создания объектов
class UserFactory {
    static create(data) {
        return {
            username: data.username,
            email: data.email || null,
            money: data.money ?? 100,       // Значение по умолчанию
            inventory: [],
            createdAt: new Date()
        };
    }
}

const user = UserFactory.create({ username: 'stalker' });
</div>

<p><strong>Зачем:</strong></p>
<ul>
    <li>Инкапсуляция логики создания (сложная инициализация скрыта)</li>
    <li>Переиспользование (одна фабрика — много объектов)</li>
    <li>Легко менять тип создаваемого объекта</li>
</ul>

<h3>12.3 Module / Revealing Module</h3>

<div class="q-block"><strong>Что:</strong> Инкапсуляция приватных данных и функций, экспорт только публичного API.</div>

<div class="code-block">
// Revealing Module Pattern (IIFE)
const UserService = (() => {
    // Приватные переменные и функции
    const cache = new Map();

    const hashPassword = async (password) => {
        return await bcrypt.hash(password, 10);
    };

    // Публичное API
    return {
        register: async (data) => {
            const hashed = await hashPassword(data.password);
            return await userRepository.create({ ...data, password: hashed });
        },
        isCached: (id) => cache.has(id)
    };
})();
</div>

<p>В современном JavaScript модули (ESM) уже реализуют паттерн — всё что не экспортировано, приватно.</p>

<h3>12.4 Observer / EventEmitter</h3>

<div class="q-block"><strong>Что:</strong> Паттерн "издатель-подписчик" — объект уведомляет всех подписчиков о событии.</div>

<div class="code-block">
import { EventEmitter } from 'events';

// Создаём свой EventEmitter
class OrderEmitter extends EventEmitter {}
const orderEmitter = new OrderEmitter();

// Подписчики (Observer'ы)
orderEmitter.on('order:created', (order) => {
    console.log(`Новый заказ: ${order.id}`);
    sendEmail(order.userEmail, 'Ваш заказ создан');
});

orderEmitter.on('order:created', (order) => {
    console.log(`Обновляем статистику`);
    updateStats(order);
});

// Издатель (Publisher)
orderEmitter.emit('order:created', { id: 123, userEmail: 'user@mail.com' });
// Все подписчики получают событие
</div>

<p><strong>В Node.js:</strong> Встроенный <span class="code-inline">EventEmitter</span> — основа <span class="code-inline">http.Server</span>, <span class="code-inline">Stream</span>, <span class="code-inline">process</span>.</p>

<div class="code-block">
// Stream — это EventEmitter
const stream = fs.createReadStream('file.txt');
stream.on('data', (chunk) => { ... });    // Подписка
stream.on('end', () => { ... });
stream.on('error', (err) => { ... });
</div>

<h3>12.5 Strategy</h3>

<div class="q-block"><strong>Что:</strong> Выбор алгоритма/поведения <strong>на лету</strong> из набора доступных стратегий.</div>

<div class="code-block">
// Стратегии валидации
const validators = {
    email: (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value),
    username: (value) => value.length >= 3 && /^[a-zA-Z0-9_]+$/.test(value),
    password: (value) => value.length >= 6
};

// Функция использует стратегию по имени
function validate(field, value) {
    const validator = validators[field];
    if (!validator) throw new Error(`Unknown field: ${field}`);
    return validator(value);
}

validate('email', 'user@mail.com');  // true
validate('username', 'ab');           // false (менее 3 символов)
</div>

<div class="code-block">
// Стратегия оплаты
class PaymentProcessor {
    constructor(strategy) {
        this.strategy = strategy;  // Стратегия оплаты
    }

    async pay(amount) {
        return this.strategy.charge(amount);
    }
}

const cardPayment = { charge: (amt) => console.log(`Списано ${amt}₽ с карты`) };
const cryptoPayment = { charge: (amt) => console.log(`Отправлено ${amt} в крипте`) };

const processor = new PaymentProcessor(cardPayment);
processor.pay(100);  // Списано 100₽ с карты
</div>

<h3>12.6 Decorator</h3>

<div class="q-block"><strong>Что:</strong> Добавление поведения объекту <strong>без изменения его кода</strong>.</div>

<div class="code-block">
// Декоратор для логирования
function withLogging(fn) {
    return async function (...args) {
        console.log(`Вызов ${fn.name} с`, args);
        const start = performance.now();
        const result = await fn.apply(this, args);
        console.log(`${fn.name} завершён за ${(performance.now() - start).toFixed(2)}ms`);
        return result;
    };
}

// Декоратор для кеширования
function withCache(fn) {
    const cache = new Map();
    return async function (...args) {
        const key = JSON.stringify(args);
        if (cache.has(key)) return cache.get(key);
        const result = await fn.apply(this, args);
        cache.set(key, result);
        return result;
    };
}

// Использование
const getUser = withLogging(withCache(async (id) => {
    return await userRepository.findById(id);
}));

await getUser('123');  // Логирует, кеширует
await getUser('123');  // Берёт из кеша
</div>

<h3>12.7 Middleware (Chain of Responsibility)</h3>

<div class="q-block"><strong>Что:</strong> Цепочка обработчиков, каждый из которых может обработать запрос или передать дальше.</div>

<div class="code-block">
// Express middleware — классический Chain of Responsibility
app.use(express.json());      // 1. Парсинг JSON
app.use(session({...}));      // 2. Сессия
app.use(currentUser);         // 3. Загрузка пользователя
app.use(updateLastSeen);      // 4. Обновление lastSeen
app.use RBAC);               // 5. Проверка прав
app.use(router);              // 6. Обработка маршрута

// Каждый звено цепочки: обработать ИЛИ передать дальше (next())
// Если произошла ошибка — next(err) передаёт в error-handling
</div>

<h3>12.8 Repository</h3>

<div class="q-block"><strong>Что:</strong> Абстракция между бизнес-логикой и источником данных (БД).</div>

<div class="diagram">
Controller → Service → Repository → Model → MongoDB
                     (абстракция)
</div>

<div class="code-block">
// Базовый репозиторий (Generics-подобный)
class BaseRepository {
    constructor(model) { this.model = model; }

    async findAll(filter, options) { return this.model.find(filter); }
    async findById(id) { return this.model.findById(id); }
    async create(data) { return this.model.create(data); }
    async update(id, data) { return this.model.findByIdAndUpdate(id, data, { new: true }); }
    async delete(id) { return this.model.findByIdAndDelete(id); }
}

// Конкретный репозиторий
class UserRepository extends BaseRepository {
    constructor() { super(User); }

    async findByEmail(email) {
        return this.findOne({ email });
    }
}
</div>

<p><strong>Зачем:</strong> Сервис не знает как работать с БД. Завтра замените MongoDB на PostgreSQL — меняете только репозитории.</p>

<h3>12.9 Proxy</h3>

<div class="q-block"><strong>Что:</strong> Обёртка над объектом, перехватывающая операции (чтение, запись, вызов).</div>

<div class="code-block">
// Валидация через Proxy
const user = {
    username: 'stalker',
    money: 100
};

const validatedUser = new Proxy(user, {
    set(target, prop, value) {
        if (prop === 'money' && value < 0) {
            throw new Error('Деньги не могут быть отрицательными');
        }
        if (prop === 'username' && value.length < 3) {
            throw new Error('Имя минимум 3 символа');
        }
        target[prop] = value;
        return true;
    }
});

validatedUser.money = 50;      // OK
validatedUser.money = -100;    // Error: Деньги не могут быть отрицательными
</div>

