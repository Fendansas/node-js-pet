socket.on('chat', (msg) => { ... }); // Сервер → клиент
</div>

<h3>11.2 Worker Threads — Детали</h3>

<div class="code-block">
import { Worker, parentPort, workerData } from 'worker_threads';

// Передача данных
const worker = new Worker('./task.js', {
    workerData: { input: largeArray },
    transferList: [buffer]  // Передача владения Buffer (без копирования)
});

// SharedArrayBuffer — общая память между потоками
const sharedBuffer = new SharedArrayBuffer(1024);
const view = new Int32Array(sharedBuffer);
Atomics.add(view, 0, 1);  // Атомарная операция
