<h2 id="modules">2. Модули и система импорта</h2>

<h3>2.1 CommonJS (CJS)</h3>

<p>Оригинальная система модулей Node.js. Используется в файлах <span class="code-inline">.js</span> без <span class="code-inline">"type": "module"</span>.</p>

<div class="code-block">
// Экспорт
module.exports = { foo: 1, bar: 2 };
// или
exports.foo = 1;

// Импорт
const { foo, bar } = require('./module');
const myModule = require('./module');
</div>

<h4>Как работает require() — 5 шагов</h4>

<div class="diagram">
require('./module')
    │
    ▼
┌─────────────┐
│ 1. RESOLVE  │  Найти файл (./module.js → ./module/index.js → ./module.json)
└──────┬──────┘
       ↓
┌─────────────┐
│ 2. LOAD     │  Прочитать содержимое файла
└──────┬──────┘
       ↓
┌─────────────┐
│ 3. COMPILE  │  Обернуть в функцию: (function(exports, require, module, __filename, __dirname) { ... })
└──────┬──────┘
       ↓
┌─────────────┐
│ 4. CACHE    │  Сохранить в require.cache (повторный вызов не читает файл)
└──────┬──────┘
       ↓
┌─────────────┐
│ 5. EXPORT   │  Вернуть module.exports
└─────────────┘
</div>

<h4>Циклические зависимости</h4>

<div class="code-block">
// a.js
const b = require('./b');
module.exports = { name: 'a' };

// b.js
const a = require('./a');  // a = {} (неполный объект — модуль ещё не экспортирован!)
module.exports = { name: 'b' };

// Проблема: при циклическом require() один из модулей будет пустым
</div>

<h3>2.2 ES Modules (ESM)</h3>

<p>Стандарт ECMAScript 2015. Используется при <span class="code-inline">"type": "module"</span> в package.json.</p>

<div class="code-block">
// Экспорт
export const foo = 1;
export default class MyClass { ... }

// Импорт
import { foo } from './module.js';
import MyClass from './module.js';
</div>

<h4>Динамический импорт</h4>

<div class="code-block">
// Статический (вверху файла, загружается сразу)
import { foo } from './module.js';

// Динамический (async, по требованию)
const module = await import('./module.js');
console.log(module.foo);

// Условный импорт
if (condition) {
    const { heavy } = await import('./heavy-module.js');
}
</div>

<h4>Top-level await</h4>

<div class="code-block">
// В ESM можно использовать await на верхнем уровне
const response = await fetch('https://api.example.com/data');
const data = await response.json();
export { data };
</div>

<h3>2.3 Сравнение CJS vs ESM</h3>

<table style="width:100%;border-collapse:collapse;margin:12px 0;">
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;color:#2dff7a;width:25%;"><strong>Критерий</strong></td><td style="padding:6px;color:#2dff7a;width:37%;"><strong>CommonJS</strong></td><td style="padding:6px;color:#2dff7a;width:38%;"><strong>ES Modules</strong></td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Синтаксис</td><td style="padding:6px;">require() / module.exports</td><td style="padding:6px;">import / export</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Загрузка</td><td style="padding:6px;">Синхронная</td><td style="padding:6px;">Асинхронная (статическая)</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Кеширование</td><td style="padding:6px;">require.cache (копия)</td><td style="padding:6px;">Ссылка (live binding)</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Условный вызов</td><td style="padding:6px;">if (x) require()</td><td style="padding:6px;">Только вверху файла</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">__dirname</td><td style="padding:6px;">Есть</td><td style="padding:6px;">Нет (через import.meta.url)</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Расширение</td><td style="padding:6px;">.js, .cjs</td><td style="padding:6px;">.js (при "type":"module"), .mjs</td></tr>
</table>

