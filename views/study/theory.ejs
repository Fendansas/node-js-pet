<h2 id="async">3. Асинхронное программирование</h2>

<h3>3.1 Call Stack и Event Queue</h3>

<div class="diagram">
┌─────────────────────────────────────────┐
│              Call Stack                   │  ← Стек вызовов (LIFO)
│  main() → getUser() → readFile()        │
└─────────────────┬───────────────────────┘
                  ↓ (async operation)
┌─────────────────────────────────────────┐
│           Microtask Queue                │  ← Promise.then, queueMicrotask
│  [priority: highest]                     │
└─────────────────┬───────────────────────┘
                  ↓
┌─────────────────────────────────────────┐
│           Macrotask Queue                │  ← setTimeout, I/O, setImmediate
│  [priority: lower]                       │
└─────────────────────────────────────────┘
</div>

<h3>3.2 Callbacks</h3>

<div class="code-block">
// Callback pattern
function fetchData(callback) {
    fs.readFile('data.json', (err, data) => {
        if (err) return callback(err);
        callback(null, JSON.parse(data));
    });
}

// Error-First Callback (Node.js соглашение)
// Первый аргумент — всегда ошибка (или null)
fs.readFile('file.txt', (error, data) => {
    if (error) {
        console.error('Ошибка:', error.message);
        return;
    }
    console.log('Данные:', data);
});
</div>

<div class="q-block"><strong>Callback Hell — проблема вложенных callback'ов</strong></div>
<div class="code-block">
// ПЛОХО — "ад callback'ов"
getUser(userId, (err, user) => {
    getOrders(user.id, (err, orders) => {
        getOrderDetails(orders[0].id, (err, details) => {
            getProduct(details.productId, (err, product) => {
                // 4 уровня вложенности — трудно читать и обрабатывать ошибки
            });
        });
    });
});
</div>

<h3>3.3 Promises</h3>

<p><strong>Promise</strong> — объект, представляющий результат асинхронной операции. Три состояния:</p>

<div class="diagram">
┌──────────┐     ┌──────────┐     ┌──────────┐
│ pending  │ ──► │fulfilled │     │ rejected │
│ (ожидание)│    │ (успех)  │     │ (ошибка) │
└──────────┘     └──────────┘     └──────────┘
</div>

<div class="code-block">
// Создание Promise
const promise = new Promise((resolve, reject) => {
    const data = fetchFromDB();
    if (data) {
        resolve(data);       // Успех → then()
    } else {
        reject(new Error('No data'));  // Ошибка → catch()
    }
});

// Использование
promise
    .then(data => console.log(data))     // resolve
    .catch(err => console.error(err))    // reject
    .finally(() => console.log('done')); // всегда
</div>

<h4>Цепочки промисов (Chaining)</h4>

<div class="code-block">
getUser(id)
    .then(user => getOrders(user.id))     // Возвращаем промис
    .then(orders => getOrderDetails(orders[0].id))
    .then(details => renderPage(details))
    .catch(err => handleError(err));       // Один обработчик для всей цепочки
</div>

<h3>3.4 async/await</h3>

<p><span class="code-inline">async/await</span> — синтаксический сахар над Promise. Код выглядит синхронным, но работает асинхронно.</p>

<div class="code-block">
// async/await — современный стандарт
async function loadPage() {
    try {
        const user = await getUser(id);            // Ждём результат
        const orders = await getOrders(user.id);   // Ждём результат
        const details = await getOrderDetails(orders[0].id);
        return renderPage(details);
    } catch (err) {
        handleError(err);  // Ловим ошибку из любого await
    }
}
</div>

<h4>Параллельные операции</h4>

<div class="code-block">
// Последовательно (медленно) — 6 секунд
const a = await fetch('/api/a');     // 3 сек
const b = await fetch('/api/b');     // 3 сек
// Итого: 6 сек

// Параллельно (быстро) — 3 секунды
const [a, b] = await Promise.all([
    fetch('/api/a'),  // 3 сек
    fetch('/api/b'),  // 3 сек (параллельно)
]);
// Итого: 3 сек

// Promise.allSettled — не падает при ошибке
const results = await Promise.allSettled([
    fetch('/api/a'),
    fetch('/api/b'),  // Если упадёт — не страшно
]);
// results = [{ status: 'fulfilled', value: ... }, { status: 'rejected', reason: ... }]

// Promise.race — первый результат (успех или ошибка)
const fastest = await Promise.race([
    fetch('/api/us-east'),
    fetch('/api/eu-west'),  // Кто быстрее — тот и победил
]);

// Promise.any — первый успешный
const first = await Promise.any([
    fetch('/api/primary'),
    fetch('/api/backup'),   // Если primary упадёт — возьмёт backup
]);
</div>

<h3>3.5 Микротаски vs Макротаски</h3>

<div class="code-block">
console.log('1: start');

setTimeout(() => console.log('2: timeout'), 0);
Promise.resolve().then(() => console.log('3: promise'));
process.nextTick(() => console.log('4: nextTick'));

console.log('5: end');

// Вывод:
// 1: start
// 5: end
// 4: nextTick    ← Microtask (приоритетнее)
// 3: promise     ← Microtask
// 2: timeout     ← Macrotask
</div>

<table style="width:100%;border-collapse:collapse;margin:12px 0;">
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;color:#2dff7a;width:25%;"><strong>Микротаски</strong></td><td style="padding:6px;color:#2dff7a;width:25%;"><strong>Макротаски</strong></td><td style="padding:6px;"><strong>Разница</strong></td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Promise.then</td><td style="padding:6px;">setTimeout</td><td style="padding:6px;">Микротаски выполняются между фазами</td></tr>
