<h2 id="auth">4. Аутентификация и Авторизация (RBAC)</h2>

<h3>Разница</h3>
<ul>
    <li><strong>Аутентификация (Authentication)</strong> — <em>кто ты?</em> (логин/пароль, сессия)</li>
    <li><strong>Авторизация (Authorization)</strong> — <em>что тебе можно?</em> (права доступа)</li>
</ul>

<h3>Как работает аутентификация в проекте</h3>

<div class="diagram">
1. POST /login { username, password }
2. AuthService.login() — проверяет пароль через bcrypt
3. req.session.user = { id, username } — сохраняет в сессию
4. Cookie connect.sid отправляется клиенту
5. При следующем запросе — currentUser middleware загружает пользователя из БД
</div>

<h3>Middleware аутентификации</h3>

<div class="code-block">
// middleware/auth.middleware.js
export const isAuth = (req, res, next) => {
    if (!req.session?.user?.id) {
        return res.redirect('/login');
    }
    next();
};
</div>

<h3>Middleware авторизации (RBAC)</h3>

<div class="code-block">
// middleware/permission.middleware.js
import RbacService from '../services/rbac.service.js';

export const allow = (permission) => {
    return async (req, res, next) => {
        const userId = req.user?._id;
        if (!userId) return res.status(401).json({ success: false, message: 'Unauthorized' });

        const hasAccess = await RbacService.hasPermission(userId, permission);
        if (!hasAccess) return res.status(403).json({ success: false, message: 'Forbidden' });

        next();
    };
};
</div>

<h3>RBAC: Role → Permission</h3>

<div class="diagram">
User ──has──► Role ──has──► Permission[]
  │            │               │
  │            │    ┌──────────┴──────────┐
  │            │    │                     │
  │            ▼    ▼                     ▼
  │          admin                     user
  │       (all perms)          (read, profile, etc.)
  │
  └──пример: { name: 'stalker', role: 'user' }
</div>

<p><strong>Иерархия:</strong> User → Role → Permission</p>
<p><strong>Пример использования в роуте:</strong></p>

<div class="code-block">
// Только админ может управлять RBAC
router.get('/rbac',
    allow('rbac:manage'),                    // Проверяем право
    (req, res) => AdminController.showRbacPage(req, res)
);

// Любой авторизованный может читать продукты
router.get('/',
    isAuth,
    (req, res) => ProductController.index(req, res)
);
</div>

<h3>Полный список прав в проекте</h3>

<div class="code-block">
// Из database/seeders/rbac.seed.js
user:create, user:read, user:update, user:delete
role:create, role:read, role:update, role:delete
permission:create, permission:read, permission:update
product:read, product:create, product:update, product:delete, product:buy, product:inventory
post:read, post:create, post:update, post:delete
event:read, event:create, event:update, event:delete
task:read, task:create, task:update, task:delete, task:assign
anomaly:read, anomaly:create, anomaly:update, anomaly:delete, anomaly:export
overlay:read, overlay:create, overlay:update, overlay:delete
dashboard:read, rbac:manage
profile:read, profile:update, avatar:manage
comment:create, comment:read, comment:delete
</div>

