<h2 id="patterns">5. Паттерны проектирования</h2>

<h3>Singleton для сервисов</h3>

<p>Все сервисы экспортируются как <strong>единственный экземпляр</strong>:</p>

<div class="code-block">
class ProductService {
    // ... методы
}
export default new ProductService();  // ← Singleton
</div>

<p><strong>Зачем:</strong> Гарантирует, что во всём приложении используется один экземпляр сервиса. Нет дублирования состояния.</p>

<h3>Наследование контроллеров (BaseController)</h3>

<div class="code-block">
// BaseController — базовый класс
class BaseController {
    handleError(res, error, message) { ... }
    successRedirect(req, res, url, message) { ... }
    renderView(res, view, data) { ... }
}

// Все контроллеры наследуются
class ProductController extends BaseController {
    async index(req, res) {
        // Используем методы BaseController
        return this.renderView(res, 'products/index', { products });
    }
}
</div>

<h3>Формат ответов API</h3>

<p><strong>Успех:</strong></p>
<div class="code-block">
{ success: true, data: { ... } }
</div>

<p><strong>Ошибка:</strong></p>
<div class="code-block">
{ success: false, message: 'Описание ошибки' }
</div>

<p><strong>Валидация:</strong></p>
<div class="code-block">
{ success: false, errors: [{ field: 'email', message: 'Некорректный email' }] }
</div>

<h3>Обработка ошибок (Error Codes → HTTP Status)</h3>

<div class="code-block">
// base.controller.js — handleError()
switch (errorCode) {
    case 'USER_NOT_FOUND':      return 404;
    case 'PRODUCT_NOT_FOUND':   return 404;
    case 'EMAIL_ALREADY_EXISTS': return 409;
    case 'INSUFFICIENT_FUNDS':  return 400;
    case 'USER_BANNED':         return 403;
    default:                    return 500;
}
</div>

<p>Сервисы бросают ошибки с кодами:</p>

<div class="code-block">
// В сервисе
const error = new Error('PRODUCT_NOT_FOUND');
error.code = 'PRODUCT_NOT_FOUND';
throw error;

// В контроллере — handleError() автоматически маппит на статус
return this.handleError(res, error, 'Product not found');
</div>

<h3>Middleware как функции высшего порядка</h3>

<p><span class="code-inline">allow()</span> — это функция, которая <strong>возвращает</strong> middleware:</p>

<div class="code-block">
// allow('product:delete') → возвращает middleware
export const allow = (permission) => {
    return async (req, res, next) => {
        // ... проверка права
        next();
    };
};

// Использование
router.delete('/:id', allow('product:delete'), controller.delete);
</div>

<h3>Паттерн Репозиторий (Repository Pattern)</h3>

<p><strong>Репозиторий</strong> — слой абстракции между сервисом и моделью Mongoose. Все запросы к БД проходят через репозиторий, а не напрямую через модель.</p>

<div class="diagram">
Controller → Service → Repository → Model → MongoDB
                     (абстракция)
</div>

<h3>Зачем нужен Репозиторий?</h3>

<div class="q-block"><strong>БЕЗ Репозитория (ПЛОХО):</strong></div>
<div class="code-block">
// Сервис напрямую работает с Mongoose — логика запросов размазана
class UserService {
    async findByUsername(username) {
        return await User.findOne({ username }).populate('role');       // Повтор кода
    }
    async findByEmail(email) {
        return await User.findOne({ email }).populate('role');         // Дублирование populate
    }
    async findWithPermissions(id) {
        return await User.findById(id).populate({
            path: 'role',
            populate: { path: 'permissions' }                         // Сложные запросы в сервисе
        });
    }
}
</div>

<div class="q-block"><strong>С Репозиторием (ПРАВИЛЬНО):</strong></div>
<div class="code-block">
// repositories/user.repository.js — ВСЯ логика запросов к БД здесь
class UserRepository extends BaseRepository {
    async findByUsername(username) {
        return await this.findOne({ username });
    }
    async findWithPermissions(id) {
        return await this.findOne({ _id: id }, {
            path: 'role', populate: { path: 'permissions' }
        });
    }
}

// services/user.service.js — чистая бизнес-логика
class UserService {
    async login(username, password) {
        const user = await userRepository.findByUsername(username);  // Чистый вызов
        if (!user) throw new Error('USER_NOT_FOUND');
        // ... проверка пароля
    }
}
</div>

<h3>Преимущества Repository</h3>

<table style="width:100%;border-collapse:collapse;margin:12px 0;">
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;color:#2dff7a;width:30%;"><strong>Преимущество</strong></td><td style="padding:6px;"><strong>Описание</strong></td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Единая точка доступа</td><td style="padding:6px;">Все запросы к модели — в одном месте. Не ищешь populate по всему коду.</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Тестируемость</td><td style="padding:6px;">Легко мокнуть репозиторий вместо всей Mongoose-модели.</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Смена БД</td><td style="padding:6px;">При замене Mongoose на другую ОДУ меняешь только репозитории, сервисы — нет.</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">DRY</td><td style="padding:6px;">populate, фильтры, сортировка — не дублируются в сервисах.</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">SRP</td><td style="padding:6px;">Сервис = бизнес-логика, Репозиторий = работа с БД. Каждый класс — одна задача.</td></tr>
</table>

<h3>BaseRepository — Базовый класс</h3>

<div class="code-block">
// base.repository.js — базовые CRUD-методы для всех репозиториев
class BaseRepository {
    constructor(model) { this.model = model; }

    async findAll(filter, options) { ... }   // find + sort + populate + select
    async findById(id, populate) { ... }     // findById с populate
    async findOne(filter, populate) { ... }  // findOne с populate
    async create(data) { ... }               // model.create()
    async update(id, data) { ... }           // findByIdAndUpdate()
    async delete(id) { ... }                 // findByIdAndDelete()
    async count(filter) { ... }              // countDocuments()
    async exists(filter) { ... }             // model.exists()
}
</div>

<h3>Конкретный репозиторий — пример</h3>

<div class="code-block">
// repositories/user.repository.js
import BaseRepository from './base.repository.js';
import User from '../models/User.js';

class UserRepository extends BaseRepository {
    constructor() {
        super(User);  // ← Передаём Mongoose-модель в базовый класс
    }

    // Специфичные методы для User
    async findByUsername(username) {
        return await this.findOne({ username });
    }

    async findWithPermissions(id) {
        return await this.findOne({ _id: id }, {
            path: 'role',
            populate: { path: 'permissions' }
        });
    }
}

export default new UserRepository();  // ← Singleton
</div>

<p><strong>Иерархия:</strong></p>
<div class="diagram">
BaseRepository (базовый CRUD)
    │
    ├── UserRepository (findByUsername, findWithPermissions)
    ├── ProductRepository (findWithCategory, findInStock)
    ├── TaskRepository (findByAssignee, findOverdue)
    └── ... другие репозитории
</div>

<h3>Сравнение: с и без Repository</h3>

<table style="width:100%;border-collapse:collapse;margin:12px 0;">
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;color:#2dff7a;width:50%;"><strong>Без Repository</strong></td><td style="padding:6px;color:#2dff7a;width:50%;"><strong>С Repository</strong></td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">User.findById(id).populate('role')</td><td style="padding:6px;">userRepository.findWithRole(id)</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Product.find({ stock: { $gt: 0 } }).sort('name')</td><td style="padding:6px;">productRepository.findInStock()</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Запросы размазаны по сервисам</td><td style="padding:6px;">Все запросы — в репозитории</td></tr>
<tr style="border-bottom:1px solid #1a3a1a;"><td style="padding:6px;">Сложно тестировать (мокаем Mongoose)</td><td style="padding:6px;">Легко мокнуть репозиторий</td></tr>
</table>

<hr>

