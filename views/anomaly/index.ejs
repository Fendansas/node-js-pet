<%- include('../partials/header', { title: 'Аномалии' }) %>

<link
        rel="stylesheet"
        href="https://unpkg.com/leaflet/dist/leaflet.css"
/>

<style>

    .anomaly-page{
        padding: 30px;
    }

    .anomaly-top{
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .anomaly-title{
        margin: 0;
        color: #2dff7a;
        text-shadow: 0 0 10px rgba(45,255,122,.4);
    }

    .anomaly-subtitle{
        opacity: .7;
        margin-top: 5px;
        font-size: 14px;
    }

    .anomaly-actions{
        display: flex;
        gap: 10px;
    }

    .anomaly-map{
        width: 100%;
        height: 700px;
        border: 1px solid #2dff7a;
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 25px;
        box-shadow: 0 0 25px rgba(45,255,122,.08);
    }

    .anomaly-table-box{
        background: rgba(10,20,10,.92);
        border: 1px solid #2dff7a;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 0 25px rgba(45,255,122,.08);
    }

    .anomaly-table{
        width: 100%;
        border-collapse: collapse;
    }

    .anomaly-table thead{
        background: rgba(45,255,122,.08);
    }

    .anomaly-table th{
        color: #2dff7a;
        font-size: 13px;
        padding: 15px;
        text-align: left;
    }

    .anomaly-table td{
        padding: 15px;
        border-top: 1px solid rgba(45,255,122,.08);
        font-size: 14px;
    }

    .anomaly-table tbody tr{
        transition: .2s;
    }

    .anomaly-table tbody tr:hover{
        background: rgba(45,255,122,.04);
    }

    .anomaly-type{
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: bold;
    }

    .dot{
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .empty-box{
        padding: 40px;
        text-align: center;
        opacity: .7;
    }

    @media(max-width: 1000px){

        .anomaly-table{
            display: block;
            overflow-x: auto;
        }

        .anomaly-map{
            height: 500px;
        }

    }

</style>

<div class="container anomaly-page">

    <div class="anomaly-top">

        <div>

            <h1 class="anomaly-title">
                Аномалии зоны
            </h1>

            <div class="anomaly-subtitle">
                Мониторинг GPS аномалий и радиусов воздействия
            </div>

        </div>

        <div class="anomaly-actions">

            <a href="/anomaly/create" class="btn">
                + Создать аномалию
            </a>

        </div>

    </div>

    <div id="map" class="anomaly-map"></div>

    <div class="anomaly-table-box">
        <a href="/anomaly/export" class="btn">
            Export TXT
        </a>
        <% if(anomalies.length > 0){ %>

            <table class="anomaly-table">

                <thead>

                <tr>
                    <th>Название</th>
                    <th>Тип</th>
                    <th>Радиус</th>
                    <th>Значение</th>
                    <th>Latitude</th>
                    <th>Longitude</th>
                    <th>Дата</th>
                    <th>Actions</th>
                </tr>

                </thead>

                <tbody>

                <% anomalies.forEach(item => { %>

                    <%
                        let color = '#2dff7a';

                        switch(item.type){

                            case 'R':
                                color = '#ff3b3b';
                                break;

                            case 'A':
                                color = '#9b5cff';
                                break;

                            case 'M':
                                color = '#00b7ff';
                                break;

                            case 'B':
                                color = '#ff8c42';
                                break;

                            case 'C':
                                color = '#00ffd5';
                                break;

                            case 'H':
                                color = '#ff5ca8';
                                break;

                            case 'F':
                                color = '#ffd000';
                                break;

                            case 'Z':
                                color = '#ffffff';
                                break;
                        }
                    %>

                    <tr>

                        <td>
                            <strong><%= item.name %></strong>
                        </td>

                        <td>

                            <div
                                    class="anomaly-type"
                                    style="
                                            background: <%= color %>20;
                                            border: 1px solid <%= color %>;
                                            color: <%= color %>;
                                            "
                            >

                                <div
                                        class="dot"
                                        style="background: <%= color %>"
                                ></div>

                                <%= item.type %>

                            </div>

                        </td>

                        <td>
                            <%= item.radius %> m
                        </td>

                        <td>
                            <%= item.value %>
                        </td>

                        <td>
                            <%= item.latitude %>
                        </td>

                        <td>
                            <%= item.longitude %>
                        </td>

                        <td>
                            <%= new Date(item.createdAt).toLocaleDateString() %>
                        </td>
                        <td>

                            <div class="actions">

                                <a
                                        href="/anomaly/edit/<%= item._id %>"
                                        class="btn"
                                >
                                    Edit
                                </a>

                                <form
                                        action="/anomaly/delete/<%= item._id %>"
                                        method="POST"
                                        onsubmit="return confirm('Удалить аномалию?')"
                                >

                                    <button
                                            class="btn danger"
                                            type="submit"
                                    >
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </td>


                    </tr>

                <% }) %>

                </tbody>

            </table>

        <% } else { %>

            <div class="empty-box">

                <h3>Аномалий пока нет</h3>

                <p>
                    Создай первую GPS аномалию
                </p>

            </div>

        <% } %>

    </div>

</div>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>

    const anomalies = <%- JSON.stringify(anomalies) %>;

    const map = L.map('map').setView([53.668850, 23.840332], 12);

    L.tileLayer(
        'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        {
            attribution: '&copy; OpenStreetMap contributors'
        }
    ).addTo(map);

    const colors = {
        R: '#ff3b3b',
        A: '#9b5cff',
        M: '#00b7ff',
        B: '#ff8c42',
        C: '#00ffd5',
        H: '#ff5ca8',
        F: '#ffd000',
        Z: '#ffffff'
    };

    anomalies.forEach(item => {

        const color = colors[item.type] || '#2dff7a';

        const marker = L.circleMarker(
            [item.latitude, item.longitude],
            {
                radius: 8,
                color: color,
                fillColor: color,
                fillOpacity: 1
            }
        ).addTo(map);

        const circle = L.circle(
            [item.latitude, item.longitude],
            {
                radius: item.radius,
                color: color,
                fillColor: color,
                fillOpacity: 0.15
            }
        ).addTo(map);

        const popup = `
            <div style="min-width:200px">

                <h3 style="margin-bottom:10px">
                    ${item.name}
                </h3>

                <p><strong>Type:</strong> ${item.type}</p>
                <p><strong>Radius:</strong> ${item.radius}m</p>
                <p><strong>Value:</strong> ${item.value}</p>

            </div>
        `;

        marker.bindPopup(popup);
        circle.bindPopup(popup);

    });

</script>

<%- include('../partials/footer') %>