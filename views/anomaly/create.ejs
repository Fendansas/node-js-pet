<%- include('../partials/header', { title: 'Создание GPS точки' }) %>
<link
        rel="stylesheet"
        href="https://unpkg.com/leaflet/dist/leaflet.css"
/>
<script>
    const anomalies = <%- JSON.stringify(anomalies || []) %>;
</script>

<style>

    .wrapper{
        display: grid;
        grid-template-columns: 400px 1fr;
        gap: 20px;
    }

    .form-block{
        padding: 20px;
        border: 1px solid #ccc;
        border-radius: 10px;
    }

    #map{
        width: 100%;
        height: 700px;
        border-radius: 10px;
    }

    .form-group{
        display: flex;
        flex-direction: column;
        margin-bottom: 15px;
    }

    input,
    select,
    button{
        padding: 10px;
    }

</style>


<div class="container">

    <h1>Создание GPS точки</h1>

    <div class="wrapper">

        <div class="form-block">

            <form action="/anomaly/create" method="POST">

                <div class="form-group">
                    <label>Название</label>
                    <input
                            type="text"
                            name="name"
                            required
                            placeholder="Введите название"
                    />
                </div>

                <div class="form-group">
                    <label>Latitude</label>
                    <input
                            type="text"
                            id="latitude"
                            name="latitude"
                            required
                            readonly
                    />
                </div>

                <div class="form-group">
                    <label>Longitude</label>
                    <input
                            type="text"
                            id="longitude"
                            name="longitude"
                            required
                            readonly
                    />
                </div>

                <div class="form-group">
                    <label>Radius</label>
                    <input
                            type="number"
                            name="radius"
                            required
                            placeholder="Например 100"
                    />
                </div>

                <div class="form-group">
                    <label>Type</label>

                    <select name="type" required>
                        <option value="">Выберите тип</option>
                        <option value="R">R=Radiation</option>
                        <option value="A">A=Anomal</option>
                        <option value="M">M=Mental</option>
                        <option value="B">B=Burer</option>
                        <option value="C">C=Controller</option>
                        <option value="H">H=Health</option>
                        <option value="F">F=Artifact</option>
                        <option value="Z">Z=Monolith</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Value</label>
                    <input
                            type="number"
                            name="value"
                            required
                            placeholder="Введите значение"
                    />
                </div>

                <button type="submit">
                    Создать точку
                </button>

            </form>

            <div class="coords-info">
                Нажмите на карту чтобы выбрать координаты
            </div>

        </div>

        <div id="map"></div>

    </div>

</div>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>

    const colors = {
        R: '#ff3b3b',
        A: '#9b5cff',
        M: '#00b7ff',
        B: '#ff8c42',
        C: '#00ffd5',
        H: '#ff5ca8',
        F: '#ffd000',
        Z: '#ffffff'
    };

    // Создаем карту
    const map = L.map('map').setView(
        [53.668850, 23.840332],
        12
    );

    // Подключаем OpenStreetMap
    L.tileLayer(
        'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        {
            attribution: '&copy; OpenStreetMap contributors'
        }
    ).addTo(map);

    // Показываем существующие аномалии
    anomalies.forEach(item => {

        const color = colors[item.type] || '#2dff7a';

        const marker = L.circleMarker(
            [item.latitude, item.longitude],
            {
                radius: 8,
                color: color,
                fillColor: color,
                fillOpacity: 1
            }
        ).addTo(map);

        const circle = L.circle(
            [item.latitude, item.longitude],
            {
                radius: Number(item.radius),
                color: color,
                fillColor: color,
                fillOpacity: 0.15
            }
        ).addTo(map);

        const popup = `
            <div style="min-width:200px">
                <h3>${item.name}</h3>
                <p><strong>Type:</strong> ${item.type}</p>
                <p><strong>Radius:</strong> ${item.radius}m</p>
                <p><strong>Value:</strong> ${item.value}</p>
            </div>
        `;

        marker.bindPopup(popup);
        circle.bindPopup(popup);

    });

    // Маркер новой точки
    let marker = null;

    // Выбор координат
    map.on('click', function (e) {

        const lat = e.latlng.lat.toFixed(6);
        const lng = e.latlng.lng.toFixed(6);

        document.getElementById('latitude').value = lat;
        document.getElementById('longitude').value = lng;

        if (marker) {
            map.removeLayer(marker);
        }

        marker = L.circleMarker(
            [lat, lng],
            {
                radius: 10,
                color: '#00ff00',
                fillColor: '#00ff00',
                fillOpacity: 1
            }
        ).addTo(map);

        marker.bindPopup(`
            <b>Новая точка</b><br>
            Lat: ${lat}<br>
            Lng: ${lng}
        `).openPopup();

    });

</script>

<%- include('../partials/footer') %>