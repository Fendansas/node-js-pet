<%- include('partials/header', { title: 'Edit profile' }) %>

<div class="edit-profile-page">

    <div class="edit-profile-box">

        <div class="edit-profile-top">

            <img
                    src="<%= user.avatar %>"
                    alt="avatar"
                    class="edit-avatar"
            >

            <div>
                <h1 class="edit-title">
                    EDIT PROFILE
                </h1>

                <p class="edit-subtitle">
                    Настройка профиля пользователя
                </p>
            </div>

        </div>

        <form
                action="/profile/edit-profile"
                method="POST"
                class="edit-profile-form"
        >

            <!-- USERNAME -->

            <div class="form-group">

                <label>Username</label>

                <input
                        type="text"
                        name="username"
                        value="<%= user.username %>"
                        placeholder="Введите username"
                >

            </div>

            <!-- EMAIL -->

            <div class="form-group">

                <label>Email</label>

                <input
                        type="email"
                        name="email"
                        value="<%= user.email %>"
                        placeholder="Введите email"
                >

            </div>

            <!-- AVATAR -->

            <div class="form-group">

                <label>Avatar URL</label>

                <input
                        type="text"
                        name="avatar"
                        value="<%= user.avatar %>"
                        placeholder="Ссылка на аватар"
                >

            </div>

            <!-- BIO -->

            <div class="form-group">

                <label>Bio</label>

                <textarea
                        name="bio"
                        placeholder="Информация о пользователе"
                ><%= user.bio %></textarea>

            </div>

            <!-- RANK -->

            <div class="form-group">

                <label>Rank</label>

                <select name="rank">

                    <option
                            value="stalker"
                            <%= user.rank === 'stalker' ? 'selected' : '' %>>
                        stalker
                    </option>

                    <option
                            value="svoboda"
                            <%= user.rank === 'svoboda' ? 'selected' : '' %>>
                        svoboda
                    </option>

                    <option
                            value="dolg"
                            <%= user.rank === 'dolg' ? 'selected' : '' %>>
                        dolg
                    </option>

                    <option
                            value="monolit"
                            <%= user.rank === 'monolit' ? 'selected' : '' %>>
                        monolit
                    </option>

                </select>

            </div>

            <!-- BUTTONS -->

            <div class="edit-actions">

                <button type="submit" class="save-btn">
                    Save changes
                </button>

                <a href="/profile" class="cancel-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

<%- include('partials/footer') %>