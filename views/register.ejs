<%- include('partials/header', { title: 'Регистрация', user }) %>

<div class="auth-container">

    <div class="auth-box">

        <h1 class="auth-title">☢ Создание сталкера</h1>
        <p class="auth-subtitle">Добро пожаловать в Зону, новичок</p>

        <form method="POST" action="/register" class="auth-form">

            <label>Email</label>
            <input type="email" name="email" placeholder="stalker@zone.ru" required>

            <label>Пароль</label>
            <input type="password" name="password" placeholder="••••••••" required>

            <button type="submit">Войти в Зону</button>

        </form>

        <a class="back-link" href="/">← Назад</a>

    </div>

</div>

<%- include('partials/footer') %>