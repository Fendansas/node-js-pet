<%- include('../partials/header', { title: post.title }) %>

<div class="container view-post-page">

    <div class="view-post-box">

        <div class="view-post-content">

            <div class="view-post-meta">

                <span class="view-post-category">
                    <%= post.category %>
                </span>

                <span class="view-post-date">
                    <%= post.createdAt.toLocaleDateString() %>
                </span>

            </div>

            <h1 class="view-post-title">
                <%= post.title %>
            </h1>

            <div class="view-post-description">
                <%= post.content %>
            </div>

            <div class="post-actions">

                <a
                        href="/posts"
                        class="btn"
                >
                    Назад
                </a>

                <% if (user.role?.name === 'admin') { %>

                    <a
                            href="/posts/<%= post._id %>/edit"
                            class="btn"
                    >
                        Редактировать
                    </a>

                <% } %>

            </div>

        </div>

    </div>

</div>

    <!-- Comments Section -->
    <div class="comments-section">
        <h2>Комментарии (<%= comments.length %>)</h2>

        <form action="/posts/<%= post._id %>/comments" method="POST" class="comment-form">
            <textarea name="text" placeholder="Написать комментарий..." required maxlength="500"></textarea>
            <button type="submit" class="btn">Отправить</button>
        </form>

        <% comments.forEach(comment => { %>
            <% const rating = ratingsMap[comment._id.toString()] || { averageRating: 0, count: 0, userRating: 0 }; %>
            <div class="comment-card">
                <div class="comment-header">
                    <span class="comment-author"><%= comment.author.username %></span>
                    <span class="comment-date"><%= new Date(comment.createdAt).toLocaleDateString() %></span>
                </div>
                <div class="comment-text"><%= comment.text %></div>
                <div class="comment-rating">
                    <% if (user._id.toString() !== comment.author._id.toString()) { %>
                        <form action="/posts/<%= post._id %>/comments/<%= comment._id %>/rate" method="POST" class="rating-form">
                            <% for (let i = 1; i <= 5; i++) { %>
                                <button type="submit" name="rating" value="<%= i %>" class="rating-star <%= i <= rating.userRating ? 'active' : '' %>">&#9733;</button>
                            <% } %>
                        </form>
                    <% } else { %>
                        <div class="rating-display">
                            <% for (let i = 1; i <= 5; i++) { %>
                                <span class="rating-star <%= i <= Math.round(rating.averageRating) ? 'active' : '' %>">&#9733;</span>
                            <% } %>
                        </div>
                    <% } %>
                    <span class="rating-info">
                        <% if (rating.count > 0) { %>
                            <%= rating.averageRating %> (<%= rating.count %>)
                        <% } else { %>
                            нет оценок
                        <% } %>
                    </span>
                </div>
                <% if (user._id.toString() === comment.author._id.toString() || user.role?.name === 'admin') { %>
                    <form action="/posts/<%= post._id %>/comments/<%= comment._id %>/delete" method="POST" class="comment-delete-form">
                        <button type="submit" class="btn danger small">Удалить</button>
                    </form>
                <% } %>
            </div>
        <% }) %>
    </div>

</div>

<%- include('../partials/footer') %>