<%- include('../partials/header', { title: 'Создать пост' }) %>

<div class="post-form-page">

    <div class="post-form-box">

        <h1 class="post-form-title">
            CREATE POST
        </h1>

        <p class="post-form-subtitle">
            Создание нового поста
        </p>

        <form
                action="/posts/create"
                method="POST"
                class="post-form"
        >

            <div class="form-group">

                <label>
                    Заголовок
                </label>

                <input
                        type="text"
                        name="title"
                        required
                >

            </div>

            <div class="form-group">

                <label>
                    Категория
                </label>

                <select name="category">

                    <% categories.forEach(category => { %>

                        <option value="<%= category %>">
                            <%= category %>
                        </option>

                    <% }) %>

                </select>

            </div>

            <div class="form-group">

                <label>
                    Статус
                </label>

                <select name="status">

                    <% statuses.forEach(status => { %>

                        <option value="<%= status %>">
                            <%= status %>
                        </option>

                    <% }) %>

                </select>

            </div>

            <div class="form-group">

                <label>
                    Описание
                </label>

                <textarea
                        name="content"
                        required
                ></textarea>

            </div>

            <div class="edit-actions">

                <button
                        type="submit"
                        class="save-btn"
                >
                    Создать
                </button>

                <a
                        href="/posts"
                        class="cancel-btn"
                >
                    Отмена
                </a>

            </div>

        </form>

    </div>

</div>

<%- include('../partials/footer') %>