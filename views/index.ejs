<%- include('partials/header', { title: 'Зона — Главная' }) %>

<div class="container">

    <!-- HERO -->
    <div class="hero">
        <h1>☢ Добро пожаловать в Зону</h1>

        <% if (user) { %>
            <p class="subtitle">
                Полевой сталкер: <span class="glow"><%= user.username %></span>
            </p>
        <% } else { %>
            <p class="subtitle">
                Ты ещё не в системе. Войди или зарегистрируйся.
            </p>
        <% } %>
    </div>

    <hr>

    <% if (user) { %>

        <!-- PLAYER STATUS -->
        <div class="grid">

            <div class="card">
                <h3>📊 Статус</h3>
                <p>❤️ HP: <span class="good"><%= user.health %></span></p>
                <p>☢ Радиация: <span class="bad"><%= user.radiation %>%</span></p>
                <p>💰 Деньги: <span class="glow"><%= user.money %></span></p>
                <p>📦 Предметов: <span class="glow"><%= totalItems %></span></p>
                <p>♻️ Потрачено: <span><%= consumedItems %></span></p>
            </div>

            <div class="card">
                <h3>🎒 Последнее в инвентаре</h3>
                <% if (latestItems.length === 0) { %>
                    <p style="opacity:0.6; font-size:13px">Инвентарь пуст</p>
                <% } else { %>
                    <% latestItems.forEach(item => { %>
                        <div style="display:flex; align-items:center; gap:10px; padding:6px 0; border-bottom:1px solid rgba(45,255,122,0.06)">
                            <img src="<%= item.descriptor?.imageUrl || '/img/default-avatar.png' %>"
                                 style="width:36px; height:36px; object-fit:contain; border-radius:4px; background:rgba(0,0,0,0.3)">
                            <div>
                                <div style="font-size:13px; color:#c7f9cc"><%= item.descriptor?.name || item.code %></div>
                                <div style="font-size:11px; opacity:0.5"><%= item.descriptor?.categoryText || '' %></div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
                <a href="/products/inventory" class="btn" style="margin-top:10px">Весь инвентарь</a>
            </div>

            <div class="card">
                <h3>⚡ Быстрые действия</h3>
                <a class="btn" href="/profile">Профиль</a>
                <a class="btn" href="/products">Магазин</a>
                <a class="btn danger" href="/logout">Выйти</a>
            </div>

        </div>

        <% if (latestProducts.length > 0) { %>
            <hr>
            <div class="zone-info">
                <h2>🆕 Новинки в магазине</h2>
                <div class="grid">
                    <% latestProducts.forEach(product => { %>
                        <div class="card" style="padding:12px">
                            <img src="<%= product.imageUrl %>"
                                 style="width:100%; height:120px; object-fit:contain; background:radial-gradient(circle at center, #0f1a12, #050805); border-radius:6px; margin-bottom:8px">
                            <div style="font-size:13px; color:#c7f9cc; margin-bottom:4px"><%= product.name %></div>
                            <div style="display:flex; justify-content:space-between; font-size:12px">
                                <span style="opacity:0.6"><%= product.categoryText %></span>
                                <span style="color:#2dff7a">€ <%= product.price %></span>
                            </div>
                            <a href="/products/<%= product._id %>" class="btn" style="margin-top:8px; width:100%; text-align:center">Смотреть</a>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>

    <% } else { %>

        <!-- GUEST -->
        <div class="guest-box">
            <div class="card center">
                <h2>Ты не в системе</h2>
                <p>Войди или зарегистрируйся, чтобы войти в Зону</p>
                <div class="auth-actions">
                    <a class="btn" href="/login">Войти</a>
                    <a class="btn" href="/register">Регистрация</a>
                </div>
            </div>
        </div>

    <% } %>

    <hr>

    <!-- ZONE INFO -->
    <div class="zone-info">
        <h2>☢ Состояние Зоны</h2>
        <div class="grid">
            <div class="card">
                <h3>Радиоактивность</h3>
                <p class="bad">Высокая</p>
            </div>
            <div class="card">
                <h3>Аномалии</h3>
                <p class="glow">Активны</p>
            </div>
            <div class="card">
                <h3>Фракции</h3>
                <p>Долг / Свобода / Монолит</p>
            </div>
        </div>
    </div>

</div>

<%- include('partials/footer') %>