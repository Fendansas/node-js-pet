<%- include('partials/header', { title: 'Вход', user }) %>

<div class="auth-container">

    <div class="auth-box">

        <h1 class="auth-title">☢ Вход в Зону</h1>
        <p class="auth-subtitle">Система контроля доступа сталкеров</p>

        <form method="POST" action="/login" class="auth-form">

            <label>Позывной</label>
            <input type="text" name="username" placeholder="Введите логин" required>

            <label>Пароль</label>
            <input type="password" name="password" placeholder="••••••••" required>

            <button type="submit">Войти в Зону</button>

        </form>

        <a class="back-link" href="/">← Назад</a>

    </div>

</div>

<%- include('partials/footer') %>