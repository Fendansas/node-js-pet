<%- include('../partials/header', { title: 'Создать хабар' }) %>
<div class="edit-profile-page">

    <div class="edit-profile-box">

        <div class="edit-profile-top">

            <div>
                <h1 class="edit-title">
                    CREATE PRODUCT
                </h1>

                <p class="edit-subtitle">
                    Добавление нового товара
                </p>
            </div>

        </div>



        <form
                action="/products/create"
                method="POST"
                enctype="multipart/form-data"
                class="edit-profile-form"
        >

            <div class="form-group">

                <label>
                    Название товара
                </label>

                <input
                        type="text"
                        name="name"
                        placeholder="AK-47"
                >

            </div>

            <div class="form-group">

                <label>
                    Описание
                </label>

                <textarea
                        name="description"
                        placeholder="Описание товара..."
                ></textarea>

            </div>

            <div class="form-group">

                <label>
                    Цена
                </label>

                <input
                        type="number"
                        name="price"
                        placeholder="999"
                >

            </div>

            <div class="form-group">

                <label>
                    Категория (0-11)
                </label>

                <input
                        type="number"
                        name="category"
                        placeholder="4"
                        min="0"
                        max="11"
                >

            </div>

            <div class="form-group">

                <label>
                    Картинка
                </label>

                <input
                        type="file"
                        name="imageUrl"
                >

            </div>

            <div class="edit-actions">

                <button
                        type="submit"
                        class="save-btn"
                >
                    Создать товар
                </button>

                <a
                        href="/products"
                        class="cancel-btn"
                >
                    Отмена
                </a>

            </div>

        </form>

    </div>

</div>

<%- include('../partials/footer') %>