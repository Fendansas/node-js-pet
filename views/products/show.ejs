<%- include('../partials/header', { title: product.name }) %>

<div class="product-show">
    <div class="product-show-back">
        <a href="/products" class="btn">← Назад</a>
    </div>

    <div class="product-show-layout">

        <div class="product-show-image">
            <img src="<%= product.imageUrl %>" alt="<%= product.name %>">
        </div>

        <div class="product-show-info">
            <span class="product-category"><%= product.categoryText %></span>
            <h1><%= product.name %></h1>
            <div class="product-show-price">€ <%= product.price %></div>
            <p class="product-show-description"><%= product.description %></p>

            <hr>

            <div class="product-show-details">
                <div class="detail-row">
                    <span class="detail-label">Code</span>
                    <span class="detail-value"><%= product.code %></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Очки опыта</span>
                    <span class="detail-value"><%= product.xpPoints %></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Длительность</span>
                    <span class="detail-value"><%= product.duration === -1 ? '∞' : (product.duration / 1000 / 60) + ' мин' %></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Тип</span>
                    <span class="detail-value">
                        <% if (product.isArtifact) { %>Артефакт<% } %>
                        <% if (product.isBooster) { %>Бустер<% } %>
                        <% if (product.isDevice) { %>Прибор<% } %>
                        <% if (product.isArmor) { %>Броня<% } %>
                        <% if (product.isSingleUse) { %>Расходуемый<% } %>
                    </span>
                </div>
            </div>

            <%
            const MODIFIER_LABELS = {
                health: 'Здоровье (регенерация)',
                radiation: 'Радиация (защита)',
                anomaly: 'Аномалия (защита)',
                mental: 'Ментальное (защита)',
                burer: 'Бюрер (защита)',
                radiationEmitter: 'Радиоактивный излучатель',
                controller: 'Контролёр (защита)',
                healthInstant: 'Здоровье (мгновенное)',
                radiationInstant: 'Радиация (мгновенная)',
                monolith: 'Монолит (защита)'
            };

            const MULTIPLIER_KEYS = ['radiation', 'anomaly', 'mental', 'burer', 'controller', 'monolith'];

            const formatValue = (key, val) => {
                if (MULTIPLIER_KEYS.includes(key)) {
                    const percent = Math.round((1 - val) * 100);
                    return (percent >= 0 ? '+' : '') + percent + '%';
                }
                return val;
            };

            const hasModifiers = product.modifiers && Object.values(product.modifiers).some(v => v !== -99999999);
            %>

            <% if (hasModifiers) { %>
                <hr>
                <h3>Модификаторы</h3>
                <div class="modifiers-list">
                    <% Object.keys(MODIFIER_LABELS).forEach(key => { %>
                        <% if (product.modifiers[key] !== undefined && product.modifiers[key] !== -99999999) { %>
                            <div class="modifier-item">
                                <span class="modifier-label"><%= MODIFIER_LABELS[key] %></span>
                                <span class="modifier-value"><%= formatValue(key, product.modifiers[key]) %></span>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
            <% } %>

            <form action="/products/<%= product._id %>/buy" method="POST" class="product-show-buy">
                <button type="submit">Купить — € <%= product.price %></button>
            </form>
        </div>

    </div>
</div>

<%- include('../partials/footer') %>