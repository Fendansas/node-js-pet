<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <title>
        <%= title %>
    </title>

    <link rel="stylesheet" href="/css/style.css">

    <!-- Шрифт под атмосферу -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
</head>

<body>

    <header class="header">
        <div class="logo">
            <a href="/">☢ STALKER ZONE</a>

        </div>

        <nav class="nav">
            <a href="/">Главная</a>
            <% if (user && user.role?.name === 'admin') { %>
                <a href="/anomaly">Карта аномалий</a>
                <a href="/anomaly/map">Карта (выделение)</a>
                <a href="/study">Study</a>
                <a href="/admin/rbac">RBAC</a>
            <% } %>
            <a href="/posts">Статьи</a>
            <a href="/products">Продукты</a>

            <a href="/profile">ПДА</a>
            <% if (user) { %>

                <% } %>

                    <% if (user) { %>
                        <img class="avatar" src="<%= user.avatar || '/img/default-avatar.png' %>" />
                        <span class="username">
                            <%= user.username %>
                        </span>
                        <a href="/logout">Выход</a>
                        <% } else { %>
                            <a href="/login">Вход</a>
                            <a href="/register">Регистрация</a>
                            <% } %>
        </nav>
    </header>

    <!-- Flash Messages -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="flash-message flash-success">
            <span>✅</span>
            <span><%= successMessage %></span>
        </div>
    <% } %>

    <% if (typeof validationErrors !== 'undefined' && validationErrors && validationErrors.length > 0) { %>
        <div class="flash-message flash-error">
            <span>❌</span>
            <span><%= validationErrors.map(e => e.msg || e).join(', ') %></span>
        </div>
    <% } %>

    <div class="container">
