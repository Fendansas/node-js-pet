# Зависимости (всегда игнорируем node_modules)
node_modules/

# Логи
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Файлы окружения (содержат секреты)
.env
.env.local
.env.*.local

# Файлы сборки и кэша
dist/
build/
.next/
out/
.cache/

# Файлы OS (мусорные файлы)
.DS_Store
Thumbs.db
desktop.ini

# Файлы IDE/редакторов (личные настройки)
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Файлы покрытия тестов
coverage/
.nyc_output/

# Файлы отчётов
*.pem
*.cert

# Временные файлы
tmp/
temp/

# Файлы отладки
debug.log

# Файлы баз данных
*.db
*.sqlite
*.sqlite3

# Файлы конфигурации пакетов (опционально)
package-lock.json  # раскомментируйте, если хотите игнорировать
yarn.lock           # раскомментируйте, если хотите игнорировать

# Файлы сгенерированной документации
docs/
apidoc/

# Файлы сессий и хранилищ
.session
.sessions/
connect.sid

