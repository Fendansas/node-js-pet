  },
  "homepage": "https://github.com/Fendandas/node-js-pet#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "gridfs-stream": "^1.1.1",
    "helmet": "^8.2.0",
    "mongoose": "^9.6.2",
